# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitness_portal?schema=public"

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET="your-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# Token expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Google OAuth (optional — email/password login works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini AI coach (optional). GEMINI_MODEL must be a currently-available model;
# legacy models (e.g. gemini-2.0-flash) hit exhausted free-tier quota pools.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Single admin bootstrap (ensureAdmin runs at API start)
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Coach"
ADMIN_PASSWORD="change-me"
