// Prisma Schema for Fitness Training Portal
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  MANAGER
  USER
}

enum RequestCategory {
  WORKOUT_MODIFICATION
  NUTRITION_REQUEST
  INJURY_UPDATE
  GENERAL
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum NotificationType {
  NEW_USER_REGISTRATION
  WORKOUT_COMPLETED
  WORKOUT_MISSED
  NEW_REQUEST
  WORKOUT_ASSIGNED
  MEAL_PLAN_UPDATED
  SUBSCRIPTION_EVENT
  GENERAL
}

enum AIDocumentType {
  KNOWLEDGE_BASE
  NUTRITION_GUIDE
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum ChargeStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AudienceType {
  ALL
  SPECIFIC
}

enum ResourceCategory {
  NUTRITION
  FORM
  MINDSET
  OTHER
}

// ==================== AUTH & USERS ====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(USER)
  active    Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordHash String?

  oauthAccounts              OAuthAccount[]
  refreshTokens              RefreshToken[]
  clientProfile              ClientProfile?
  onboarding                 OnboardingQuestionnaire?
  workoutPlans               WorkoutPlan[]
  workoutCompletions         WorkoutCompletion[]
  nutritionTarget            NutritionTarget?
  mealPlans                  MealPlan[]
  foodLogs                   FoodLog[]
  weightLogs                 WeightLog[]
  checkIns                   CheckIn[]
  userRequests               UserRequest[]
  notifications              Notification[]
  aiConversations            AIConversation[]
  accountabilitySubscription AccountabilitySubscription?
  missedWorkoutCharges       MissedWorkoutCharge[]
  announcements              Announcement[]             @relation("AnnouncementRecipient")

  managedClients  ManagerClient[] @relation("ManagerToClient")
  assignedManager ManagerClient?  @relation("ClientToManager")

  @@index([email])
  @@index([role])
}

model OAuthAccount {
  id             String    @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ManagerClient {
  id        String   @id @default(uuid())
  managerId String
  clientId  String   @unique
  createdAt DateTime @default(now())

  manager User @relation("ManagerToClient", fields: [managerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientToManager", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([managerId])
}

model ClientProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  height           Float?
  weight           Float?
  age              Int?
  gender           String?
  goal             String?
  notes            String?
  profilePhotoUrl  String?
  timezone         String?  @default("UTC")
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingQuestionnaire {
  id                  String    @id @default(uuid())
  userId              String    @unique
  height              Float?
  weight              Float?
  age                 Int?
  gender              String?
  fitnessExperience   String?
  dailyWorkoutMinutes Int?
  fitnessGoals        String[]
  injuries            String?
  dietaryRestrictions String[]
  equipment           String[]
  activityLevel       String?
  completed           Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== WORKOUT PLANS ====================

model WorkoutPlan {
  id        String    @id @default(uuid())
  userId    String
  title     String
  weekStart DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDays WorkoutDay[]

  @@index([userId])
}

model WorkoutDay {
  id            String   @id @default(uuid())
  workoutPlanId String
  dayOfWeek     Int
  title         String
  isRestDay     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workoutPlan WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  completions WorkoutCompletion[]

  @@index([workoutPlanId])
}

model Exercise {
  id           String   @id @default(uuid())
  workoutDayId String
  name         String
  sets         Int
  reps         String
  restSeconds  Int?
  notes        String?
  youtubeUrl   String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@index([workoutDayId])
}

model WorkoutCompletion {
  id              String   @id @default(uuid())
  userId          String
  workoutDayId    String
  completedAt     DateTime @default(now())
  durationMinutes Int?
  feedback        String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutDayId, completedAt])
  @@index([userId])
  @@index([workoutDayId])
}

// ==================== NUTRITION ====================

model NutritionTarget {
  id          String   @id @default(uuid())
  userId      String   @unique
  calories    Int
  protein     Int
  carbs       Int
  fat         Int
  waterLiters Float    @default(2.5)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  weekStart DateTime @db.Date
  breakfast Json
  lunch     Json
  dinner    Json
  snacks    Json
  groceries Json
  calories  Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model FoodLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  mealName  String
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ==================== PROGRESS TRACKING ====================

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  weight    Float
  note      String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model CheckIn {
  id         String   @id @default(uuid())
  userId     String
  weekOf     DateTime @db.Date
  energy     Int
  sleepHours Float
  stress     Int
  adherence  Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
  @@index([userId])
}

// ==================== AI ====================

model AIDocument {
  id        String         @id @default(uuid())
  title     String
  type      AIDocumentType
  content   String         @db.Text
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type, active])
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==================== REQUESTS & NOTIFICATIONS ====================

model UserRequest {
  id         String          @id @default(uuid())
  userId     String
  category   RequestCategory
  subject    String
  body       String          @db.Text
  status     RequestStatus   @default(PENDING)
  adminReply String?         @db.Text
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ==================== ACCOUNTABILITY / STRIPE ====================

model AccountabilitySubscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  active               Boolean  @default(false)
  tier                 String   @default("free")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MissedWorkoutCharge {
  id                    String       @id @default(uuid())
  userId                String
  workoutDate           DateTime     @db.Date
  amount                Int          @default(1000)
  stripePaymentIntentId String?
  status                ChargeStatus @default(PENDING)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== COMMUNICATION ====================

model Announcement {
  id           String       @id @default(uuid())
  title        String
  body         String
  audienceType AudienceType @default(ALL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  recipients User[] @relation("AnnouncementRecipient")

  @@index([createdAt])
}

model Resource {
  id          String           @id @default(uuid())
  title       String
  description String?
  url         String
  category    ResourceCategory @default(OTHER)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
}
