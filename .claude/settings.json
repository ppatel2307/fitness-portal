{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:studio)",
      "Bash(npx prisma*)",
      "Bash(find * -type f*)",
      "Bash(ls*)",
      "Bash(cat*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(npm run db:migrate:prod)",
      "Bash(rm -rf apps/*)"
    ]
  }
}
